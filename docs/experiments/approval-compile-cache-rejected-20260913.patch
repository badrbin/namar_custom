+from __future__ import annotations
+
+import ast
+from contextlib import contextmanager
+import importlib
+import os
+from pathlib import Path
+import sys
+import types
+import unittest
+from unittest.mock import patch
+
+from test_followup_approval_counts import load_service
+
+
+SOURCE = Path(os.environ.get("FRAPPE_TEST_SOURCE_ROOT", "/nonexistent"))
+try:
+    import RestrictedPython
+    import RestrictedPython.Guards
+    from RestrictedPython.transformer import RestrictingNodeTransformer
+except ImportError:
+    RestrictedPython = None
+
+
+@contextmanager
+def native_evaluator():
+    """Use actual Frappe source AST and actual RestrictedPython, not builtin eval."""
+    service, _ = load_service()
+    RequestLocalSafeEval = service.ApprovalRoutingResolver.__init__.__globals__["RequestLocalSafeEval"]
+
+    frappe = types.ModuleType("frappe")
+    utils = types.ModuleType("frappe.utils")
+    native = types.ModuleType("frappe.utils.safe_exec")
+    native.__file__ = str(SOURCE / "utils" / "safe_exec.py")
+    inplace = {}
+    exec(compile((SOURCE / "utils" / "inplacevar.py").read_text(), str(SOURCE / "utils" / "inplacevar.py"), "exec"), inplace)
+    native.__dict__.update(
+        ast=ast, types=types, RestrictedPython=RestrictedPython,
+        RestrictingNodeTransformer=RestrictingNodeTransformer,
+        compile_restricted=RestrictedPython.compile_restricted,
+        ARGUMENT_NOT_SET=object(), protected_inplacevar=inplace["protected_inplacevar"],
+    )
+    selected = {
+        "FrappeTransformer", "safe_eval", "_validate_safe_eval_syntax", "_getitem",
+        "UNSAFE_ATTRIBUTES", "_get_attr_for_eval", "_validate_attribute_read", "WHITELISTED_SAFE_EVAL_GLOBALS",
+    }
+    tree = ast.parse(Path(native.__file__).read_text())
+    nodes = [node for node in tree.body if getattr(node, "name", None) in selected or (
+        isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id in selected for target in node.targets)
+    )]
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), native.__file__, "exec"), native.__dict__)
+    facade_source = SOURCE / "__init__.py"
+    facade = next(node for node in ast.parse(facade_source.read_text()).body if isinstance(node, ast.FunctionDef) and node.name == "safe_eval")
+    exec(compile(ast.Module(body=[facade], type_ignores=[]), str(facade_source), "exec"), frappe.__dict__)
+    utils.safe_exec = native
+    frappe.utils = utils
+    with patch.dict(sys.modules, {"frappe": frappe, "frappe.utils": utils, "frappe.utils.safe_exec": native}):
+        yield frappe, native, RequestLocalSafeEval(frappe)
+
+
+@contextmanager
+def call_counts(*functions):
+    counts = {function.__code__: 0 for function in functions}
+    previous = sys.getprofile()
+
+    def count(frame, event, arg):
+        if event == "call" and frame.f_code in counts:
+            counts[frame.f_code] += 1
+
+    sys.setprofile(count)
+    try:
+        yield counts
+    finally:
+        sys.setprofile(previous)
+
+
+@unittest.skipUnless(RestrictedPython is not None and (SOURCE / "utils" / "safe_exec.py").is_file(), "Provide Frappe source and its RestrictedPython dependency for native security checks")
+class NativeSafeEvalCacheTestCase(unittest.TestCase):
+    def test_compiles_once_but_validates_and_uses_current_data_every_time(self):
+        with native_evaluator() as (frappe, native, evaluate):
+            original_globals = dict(native.__dict__)
+            compiler = native.compile_restricted
+            validator = native._validate_safe_eval_syntax
+            with call_counts(compiler, validator) as counts:
+                for value in (1, 3, 5, 8):
+                    self.assertEqual(evaluate("value > 3", {}, {"value": value}), value > 3)
+            self.assertEqual(counts[compiler.__code__], 1)
+            self.assertEqual(counts[validator.__code__], 4)
+            self.assertFalse(evaluate._disabled)
+            self.assertEqual(native.__dict__, original_globals)
+
+    def test_native_parity_for_nfkc_and_blocked_syntax_on_first_and_repeated_use(self):
+        expressions = (
+            "value + 1", "ｖａｌｕｅ + 1", "(lambda: 1)()", "(value := 3)",
+            "_private", "value.__class__", "mapping['_private']", "__import__('os')", "missing_name",
+        )
+        with native_evaluator() as (_, native, evaluate):
+            for expression in expressions:
+                for repeat in range(2):
+                    outcomes = []
+                    for engine in (native.safe_eval, evaluate):
+                        try:
+                            outcomes.append(("value", engine(expression, {}, {"value": 2, "mapping": {"_private": 3}})))
+                        except Exception as error:
+                            outcomes.append(("error", type(error)))
+                    with self.subTest(expression=expression, repeat=repeat):
+                        self.assertEqual(*outcomes)
+
+    def test_fresh_globals_guard_overrides_and_mutable_locals_are_not_shared(self):
+        with native_evaluator() as (_, native, evaluate):
+            for user in ("A", "B"):
+                values = []
+                globals_ = {"who": lambda: user, "__builtins__": {"__import__": __import__}, "_getitem_": lambda *args: "bypass"}
+                self.assertEqual(evaluate("who()", globals_, {}), user)
+                self.assertEqual(globals_["__builtins__"], {})
+                self.assertIs(globals_["_getitem_"], native.WHITELISTED_SAFE_EVAL_GLOBALS["_getitem_"])
+                self.assertIsNone(evaluate("values.append(1)", {}, {"values": values}))
+                self.assertEqual(values, [1])
+
+    def test_bad_compilation_is_not_cached_and_execution_result_is_never_cached(self):
+        with native_evaluator() as (_, native, evaluate):
+            compiler = native.compile_restricted
+            with call_counts(compiler) as counts:
+                for _ in range(2):
+                    with self.assertRaises(SyntaxError):
+                        evaluate("_blocked", {}, {})
+            self.assertEqual(counts[compiler.__code__], 2)
+            with self.assertRaises(ZeroDivisionError):
+                evaluate("1 / value", {}, {"value": 0})
+            self.assertEqual(evaluate("1 / value", {}, {"value": 2}), 0.5)
+
+    def test_policy_method_hardening_invalidates_cached_code_for_the_rest_of_request(self):
+        with native_evaluator() as (_, native, evaluate):
+            policy = native.FrappeTransformer
+            original = policy.check_name
+            self.assertTrue(evaluate("allowed_name", {}, {"allowed_name": True}))
+
+            def reject(self, node, name, *args, **kwargs):
+                if name == "allowed_name":
+                    self.error(node, "new restriction")
+                else:
+                    original(self, node, name, *args, **kwargs)
+
+            with patch.object(policy, "check_name", reject):
+                with self.assertRaises(SyntaxError):
+                    evaluate("allowed_name", {}, {"allowed_name": True})
+            self.assertTrue(evaluate._disabled)
+            self.assertEqual(evaluate._compiled, {})
+            with call_counts(native.compile_restricted) as counts:
+                self.assertTrue(evaluate("allowed_name", {}, {"allowed_name": True}))
+            self.assertEqual(counts[native.compile_restricted.__code__], 1)
+
+    def test_changed_restriction_constants_invalidate_cache(self):
+        transformer = importlib.import_module("RestrictedPython.transformer")
+        with native_evaluator() as (_, native, evaluate):
+            self.assertTrue(evaluate("allowed_name", {}, {"allowed_name": True}))
+            with patch.object(transformer, "FORBIDDEN_FUNC_NAMES", transformer.FORBIDDEN_FUNC_NAMES | {"allowed_name"}):
+                with self.assertRaises(SyntaxError):
+                    evaluate("allowed_name", {}, {"allowed_name": True})
+            self.assertTrue(evaluate._disabled)
+
+    def test_validator_and_whitelist_changes_take_effect_on_every_evaluation(self):
+        with native_evaluator() as (_, native, evaluate):
+            self.assertEqual(evaluate("int(value)", {}, {"value": "2"}), 2)
+            with patch.dict(native.WHITELISTED_SAFE_EVAL_GLOBALS, {"int": lambda value: 9}):
+                self.assertEqual(evaluate("int(value)", {}, {"value": "2"}), 9)
+            def reject(code):
+                raise SyntaxError("current validator")
+            with patch.object(native, "_validate_safe_eval_syntax", reject):
+                with self.assertRaisesRegex(SyntaxError, "current validator"):
+                    evaluate("int(value)", {}, {"value": "2"})
+
+    def test_custom_facade_and_compiler_paths_are_not_bypassed(self):
+        with native_evaluator() as (frappe, native, evaluate):
+            self.assertEqual(evaluate("1 + 1", {}, {}), 2)
+            calls = []
+            original = frappe.safe_eval
+            def custom(code, globals_, locals_):
+                calls.append(code)
+                return original(code, globals_, locals_)
+            with patch.object(frappe, "safe_eval", custom):
+                self.assertEqual(evaluate("1 + 1", {}, {}), 2)
+            self.assertEqual(calls, ["1 + 1"])
+            self.assertTrue(evaluate._disabled)
+        with native_evaluator() as (_, native, evaluate):
+            original = native.compile_restricted
+            calls = []
+            def custom_compile(*args, **kwargs):
+                calls.append(args[0])
+                return original(*args, **kwargs)
+            with patch.object(native, "compile_restricted", custom_compile):
+                self.assertEqual(evaluate("1 + 1", {}, {}), 2)
+                self.assertEqual(evaluate("1 + 1", {}, {}), 2)
+            self.assertEqual(calls, ["1 + 1", "1 + 1"])
+
+
+if __name__ == "__main__":
+    unittest.main()
