+def _standard_safe_eval_facade(code, eval_globals=None, eval_locals=None):
+    """Shape reference only; never executed instead of Frappe's evaluator."""
+    from frappe.utils.safe_exec import safe_eval
+
+    return safe_eval(code, eval_globals, eval_locals)
+
+
+def _function_stamp(function):
+    if not isinstance(function, FunctionType):
+        return function
+    return (
+        function, function.__code__, function.__defaults__,
+        tuple((function.__kwdefaults__ or {}).items()),
+        tuple(cell.cell_contents for cell in function.__closure__ or ()),
+    )
+
+
+def _restriction_value(value):
+    if isinstance(value, dict):
+        return tuple((key, _restriction_value(item)) for key, item in value.items())
+    if isinstance(value, (set, frozenset)):
+        return frozenset(_restriction_value(item) for item in value)
+    if isinstance(value, (tuple, list)):
+        return tuple(_restriction_value(item) for item in value)
+    return value
+
+
+class RequestLocalSafeEval:
+    """Memoize successful native compilation, never validation or evaluation.
+
+    Unknown/custom entry points retain the original path. Changing the native
+    compiler/policy during this request permanently disables this optimization.
+    """
+
+    def __init__(self, frappe):
+        self.frappe = frappe
+        self._compiled = {}
+        self._signature = None
+        self._disabled = False
+
+    def _native_context(self):
+        facade = self.frappe.safe_eval
+        expected = _standard_safe_eval_facade.__code__
+        if not isinstance(facade, FunctionType) or facade.__globals__ is not self.frappe.__dict__:
+            return None
+        code = facade.__code__
+        if (
+            code.co_code != expected.co_code or code.co_names != expected.co_names
+            or code.co_consts[1:] != expected.co_consts[1:]
+            or code.co_argcount != 3 or code.co_kwonlyargcount or code.co_freevars
+            or facade.__defaults__ != (None, None) or facade.__kwdefaults__
+            or getattr(facade, "__wrapped__", None) is not None
+        ):
+            return None
+        native_module = importlib.import_module("frappe.utils.safe_exec")
+        compiler_module = importlib.import_module("RestrictedPython.compile")
+        transformer_module = importlib.import_module("RestrictedPython.transformer")
+        package = importlib.import_module("RestrictedPython")
+        native = native_module.safe_eval
+        compiler = native.__globals__.get("compile_restricted") if isinstance(native, FunctionType) else None
+        policy = native.__globals__.get("FrappeTransformer") if isinstance(native, FunctionType) else None
+        helper = compiler_module._compile_restricted_mode
+        if (
+            not isinstance(native, FunctionType) or native.__globals__ is not vars(native_module)
+            or getattr(native, "__wrapped__", None) is not None
+            or not isinstance(compiler, FunctionType)
+            or compiler is not compiler_module.compile_restricted or compiler is not package.compile_restricted
+            or compiler.__globals__ is not vars(compiler_module)
+            or compiler.__code__.co_filename != compiler_module.__file__
+            or not isinstance(helper, FunctionType) or helper.__globals__ is not vars(compiler_module)
+            or not isinstance(policy, type) or policy.__module__ != native_module.__name__
+            or policy.__bases__ != (transformer_module.RestrictingNodeTransformer,)
+        ):
+            return None
+        methods = tuple(
+            (cls, name, _function_stamp(value))
+            for cls in policy.__mro__ for name, value in vars(cls).items()
+            if name not in {"__doc__", "__dict__", "__weakref__", "__annotations__"}
+        )
+        restrictions = tuple(
+            (name, _restriction_value(getattr(transformer_module, name)))
+            for name in ("FORBIDDEN_FUNC_NAMES", "INSPECT_ATTRIBUTES", "ALLOWED_FUNC_NAMES", "IOPERATOR_TO_STR")
+        )
+        signature = (
+            _function_stamp(native), _function_stamp(compiler), _function_stamp(helper), methods,
+            restrictions, _function_stamp(transformer_module.copy_locations),
+            _function_stamp(ast.parse), builtins.compile,
+        )
+        hash(signature)  # Unknown mutable custom state follows the uncached path.
+        return native, compiler, policy, signature
+
+    def __call__(self, code, eval_globals=None, eval_locals=None):
+        if self._disabled:
+            return self.frappe.safe_eval(code, eval_globals, eval_locals)
+        try:
+            context = self._native_context()
+        except (ImportError, AttributeError, TypeError):
+            context = None
+        if context is None or (self._signature is not None and self._signature != context[3]):
+            self._compiled.clear()
+            self._disabled = True
+            return self.frappe.safe_eval(code, eval_globals, eval_locals)
+        native, compiler, policy, signature = context
+        self._signature = signature
+
+        def cached_compile(*args, **kwargs):
+            key = (native.__code__, compiler, compiler.__code__, policy, args, tuple(sorted(kwargs.items())))
+            try:
+                hash(key)
+            except TypeError:
+                return compiler(*args, **kwargs)
+            if key not in self._compiled:
+                compiled = compiler(*args, **kwargs)
+                if isinstance(compiled, CodeType):
+                    self._compiled[key] = compiled
+                return compiled
+            return self._compiled[key]
+
+        # Use the current native body, validator and guard globals each time.
+        # Only this private function's compiler binding changes.
+        namespace = dict(native.__globals__)
+        namespace["compile_restricted"] = cached_compile
+        evaluate = FunctionType(native.__code__, namespace, native.__name__, native.__defaults__, native.__closure__)
+        evaluate.__kwdefaults__ = dict(native.__kwdefaults__) if native.__kwdefaults__ is not None else None
+        return evaluate(code, eval_globals, eval_locals)
+
